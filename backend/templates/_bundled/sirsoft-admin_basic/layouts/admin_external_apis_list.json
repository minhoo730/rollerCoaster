{
  "version": "1.0.0",
  "layout_name": "admin_external_apis_list",
  "extends": "_admin_base",
  "meta": {
    "title": "$t:admin.external_apis.page_title",
    "description": "$t:admin.external_apis.page_description"
  },
  "transition_overlay": {
    "wait_for": [
      "external_apis"
    ],
    "target": "external_apis_data_grid__body",
    "fallback_target": "right_content_area"
  },
  "data_sources": [
    {
      "id": "external_apis",
      "type": "api",
      "endpoint": "/api/admin/external-apis",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "loading_strategy": "progressive",
      "fallback": {
        "data": {
          "data": [],
          "current_page": 1,
          "last_page": 1,
          "per_page": 20,
          "total": 0
        }
      }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "external_apis_list_content",
        "type": "basic",
        "name": "Div",
        "props": {
          "id": "external_apis_list_content",
          "className": "p-6 bg-gray-50 dark:bg-gray-900 min-h-screen",
          "style": {
            "padding": "1.5rem",
            "minHeight": "100vh"
          }
        },
        "responsive": {
          "portable": {
            "props": {
              "id": "external_apis_list_content",
              "className": "p-4 bg-gray-50 dark:bg-gray-900 min-h-screen",
              "style": {
                "padding": "1rem",
                "minHeight": "100vh"
              }
            }
          }
        },
        "children": [
          {
            "id": "page_header",
            "type": "composite",
            "name": "PageHeader",
            "props": {
              "title": "$t:admin.external_apis.page_title",
              "description": "$t:admin.external_apis.page_description"
            }
          },
          {
            "id": "external_apis_data_grid",
            "type": "composite",
            "name": "DataGrid",
            "blur_until_loaded": true,
            "props": {
              "id": "external_apis_data_grid",
              "columns": [
                {
                  "field": "code",
                  "header": "종목코드",
                  "sortable": true,
                  "required": true
                },
                {
                  "field": "name",
                  "header": "종목명",
                  "sortable": true,
                  "required": true
                },
                {
                  "field": "market",
                  "header": "시장",
                  "sortable": true
                },
                {
                  "field": "venue",
                  "header": "거래소",
                  "sortable": true
                },
                {
                  "field": "sector",
                  "header": "업종",
                  "sortable": true
                },
                {
                  "field": "is_active",
                  "header": "상태",
                  "sortable": true
                },
                {
                  "field": "source",
                  "header": "제공처",
                  "sortable": true
                },
                {
                  "field": "last_synced_at",
                  "header": "최근 동기화",
                  "sortable": true
                }
              ],
              "data": "{{external_apis?.data?.data ?? []}}",
              "sortable": true,
              "pagination": true,
              "alwaysShowPagination": true,
              "pageSize": 20,
              "serverSidePagination": false,
              "idField": "id",
              "responsiveBreakpoint": 768,
              "emptyMessage": "표시할 외부 API 데이터가 없습니다."
            }
          }
        ]
      }
    ]
  }
}